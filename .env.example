# Node 22.16+ (disarankan Node 24 LTS). Server + API berjalan di satu origin.
PORT=3002
HOST=127.0.0.1
VASSEL_DATA_DIR=./data
# Membuat 1 admin + 1 pembeli demo jika belum ada. Bukan payment gateway.
DEMO_MODE=true
# Isi origin HTTPS saat dipasang di server. Jangan akhiri dengan slash.
# PUBLIC_ORIGIN=https://vassel.example
# Gunakan true pada hosting HTTPS; false untuk localhost HTTP.
COOKIE_SECURE=false
